    'tests/test_vr_turn_input.cpp',
    'tests/test_vr_options.cpp',
    'tests/test_vr_action_filter.cpp',
    'tests/test_vr_menu_pointer.cpp',
    'tests/test_vr_weapon_aim.cpp',
    'tests/test_vr_hand_fingers.cpp',
    'tests/test_vr_melee.cpp',
    'tests/test_vr_pipboy_gaze.cpp',
    'tests/test_vr_pipboy_size.cpp',
    'tests/test_vr_hand_hud.cpp',
    'tests/test_vr_head_hud.cpp',
    'tests/test_vr_frame_stats.cpp',
    'tests/test_vr_game_timer_stats.cpp',
    'tests/test_vr_game_timer_step.cpp',
    'tests/test_vr_render_profile.cpp',
    'tests/test_vr_weapon_types.cpp',
    'tests/test_vr_power_attack.cpp',
    'tests/test_vr_magazine.cpp',
    'tests/test_vr_terminal.cpp',
    'tests/test_vr_terminal_keyboard_mount.cpp',
    'tests/test_vr_sound_keys.cpp',
    'tests/test_vr_throw.cpp',
    'tests/test_vr_sneak.cpp',
    'tests/test_vr_holster.cpp',
    'tests/test_vr_quick_wheel.cpp',
    'tests/test_vr_grab.cpp',
    'tests/test_vr_grab_fingers.cpp',
    'tests/test_vr_hand_body.cpp',
  ])

  vr_test = executable('vr_tests', vr_test_sources, vr_src,
    files('../../util/util_matrix.cpp'),
    native              : true,
    include_directories : include_directories('../../../include/vulkan/include'),
    cpp_args            : [ '-DVR_OPENVR_DIR="@0@"'.format(meson.current_source_dir() / 'openvr') ],
    override_options    : [ 'cpp_std=c++17' ])

  test('vr', vr_test)
endif
