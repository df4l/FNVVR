{
  "controller_type": "frame_controller",
  "name": "Fallout: New Vegas VR - Steam Frame",
  "description": "Default Steam Frame bindings: left stick moves, right stick turns, right trigger attacks, right grip grabs or switches the Pip-Boy light near the left forearm, left grip holds the weapon with both hands, left trigger handles the manual magazine, right A activates, right B jumps, right X reloads, and right Y pauses (hold) or waits (tap). Left-stick click sneaks and right-stick click uses V.A.T.S. In menus either hand points with a laser and either trigger clicks; A selects and B goes back.",
  "bindings": {
    "/actions/game": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/game/in/move"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/sneak"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/game/in/turn"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/vats"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/game/in/attack"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/game/in/magazine"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/game/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/game/in/two_hand_grip"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/activate"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/jump"
            }
          }
        },
        {
          "path": "/user/hand/right/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/reload"
            }
          }
        },
        {
          "path": "/user/hand/right/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/pause_hold"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/game/out/haptic_left",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/game/out/haptic_right",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    },
    "/actions/menu": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/menu/in/navigate"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/menu/in/secondary"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/select"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/back"
            }
          }
        },
        {
          "path": "/user/hand/right/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/alternate"
            }
          }
        },
        {
          "path": "/user/hand/right/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/option"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/left_trigger"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/right_trigger"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/previous"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/next"
            }
          }
        }
      ]
    },
    "/actions/hands": {
      "poses": [
        {
          "output": "/actions/hands/in/aim_left",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/hands/in/aim_right",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "skeleton": [
        {
          "output": "/actions/hands/in/skeleton_left",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/hands/in/skeleton_right",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ]
    }
  }
}
