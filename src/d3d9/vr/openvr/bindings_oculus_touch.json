{
  "controller_type": "oculus_touch",
  "name": "Fallout: New Vegas VR - Touch",
  "description": "Default bindings: left stick moves, right stick turns, the right trigger attacks, the right grip grabs, or switches the Pip-Boy light while the right hand is at the left forearm, the left grip holds the weapon with both hands, the left trigger takes a magazine out of the weapon, takes a new one behind the left shoulder and inserts it, X reloads the weapons not reloaded by hand, or activates while the interaction prompt is at the left hand, holding Y pauses, tapping Y waits, looking at the left forearm opens the Pip-Boy. In menus each hand points with a laser and its trigger clicks; in dialogues X also clicks with the left laser.",
  "bindings": {
    "/actions/game": {
      "sources": [
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/game/in/move"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/sneak"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/game/in/turn"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/vats"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/game/in/attack"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/game/in/magazine"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/game/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/game/in/two_hand_grip"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/activate"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/jump"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/reload"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/game/in/pause_hold"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/game/out/haptic_left",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/game/out/haptic_right",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    },
    "/actions/menu": {
      "sources": [
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/menu/in/navigate"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/menu/in/secondary"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/select"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/back"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/alternate"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/option"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/left_trigger"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/right_trigger"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/previous"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/next"
            }
          }
        }
      ]
    },
    "/actions/hands": {
      "poses": [
        {
          "output": "/actions/hands/in/aim_left",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/hands/in/aim_right",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "skeleton": [
        {
          "output": "/actions/hands/in/skeleton_left",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/hands/in/skeleton_right",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ]
    }
  }
}
